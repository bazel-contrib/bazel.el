# shellcheck disable=SC3040
set -Cefu -o pipefail

case "$#" in
  0) tag="$(git tag --points-at=HEAD -- 'v*')" ;;
  1) tag="$1" ;;
  *) echo "Usage: $0 [TAG]" >&2
     exit 2 ;;
esac

if [ -z "${tag}" ]; then
  echo 'No tag given' >&2
  exit 2
fi

root="$(git rev-parse --show-toplevel)"

set -x

cd "${root}"

make release

gh release create --draft --generate-notes -- \
  "${tag:?}" bazel-bin/dev/release.tar
