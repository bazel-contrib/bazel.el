Name: Indent after colon
Code: (lambda () (bazel-build-mode) (newline-and-indent))
Point-Char: |

=-=
def foo():|
=-=
def foo():
    |
=-=-=

Name: Indent region
Code: (lambda () (bazel-build-mode) (indent-region (point-min) (point-max)))

=-=
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "lib",
    srcs = [
        "aaa.cc",
    ] + glob(["*_test.cc"]),
)

# A slightly more complex construct.
[
    cc_binary(
        name = name,
        srcs = name + ".cc",
    )
    for name in [
        "bin-a",
        "bin-b",
    ]
]
=-=-=

Name: beginning-of-defun
Code: (lambda () (bazel-build-mode) (beginning-of-defun))
Point-Char: |

=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el|"],
)
=-=
# Some comment.

|elisp_library(
    name = "bazel",
    srcs = ["bazel.el"],
)
=-=-=

Name: end-of-defun
Code: (lambda () (bazel-build-mode) (end-of-defun))
No-After-Newline: t
Point-Char: |

=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el|"],
)
=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el"],
)
|
=-=-=
