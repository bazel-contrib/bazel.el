Name: Indent after colon
Code: (lambda () (bazel-build-mode) (newline-and-indent))
Point-Char: |

=-=
def foo():|
=-=
def foo():
    |
=-=-=

Name: Indent region
Code: (lambda () (bazel-build-mode) (indent-region (point-min) (point-max)))

=-=
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "lib",
    srcs = [
        "aaa.cc",
    ] + glob(["*_test.cc"]),
)

# A slightly more complex construct.
[
    cc_binary(
        name = name,
        srcs = name + ".cc",
    )
    for name in [
        "bin-a",
        "bin-b",
    ]
]
=-=-=

Name: beginning-of-defun
Code: (lambda () (bazel-build-mode) (beginning-of-defun))
Point-Char: |

=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el|"],
)
=-=
# Some comment.

|elisp_library(
    name = "bazel",
    srcs = ["bazel.el"],
)
=-=-=

Name: end-of-defun
Code: (lambda () (bazel-build-mode) (end-of-defun))
No-After-Newline: t
Point-Char: |

=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el|"],
)
=-=
# Some comment.

elisp_library(
    name = "bazel",
    srcs = ["bazel.el"],
)
|
=-=-=

Name: Font Locking
Code: (lambda () (bazel-build-mode) (htmlfontify-buffer))

=-=
# comment

load('foo.bzl', '''foo''')

cc_library(
    name = 'foo',
    # keep sorted
    srcs = glob(['*.cc']),
    alwayslink = True,
    linkstatic=True,
)

some_rule(name = 'foo' + SUFFIX)

name_only(name = 'foo')

some_rule(
    filename = 'file.txt',
    load=0, glob=1
)
=-=
<span class="comment-delimiter"># </span><span class="comment">comment
</span>
<span class="keyword">load</span>(<span class="string">'foo.bzl'</span>, <span class="string">'''foo'''</span>)

cc_library(
    name = <span class="string">'</span><span class="variable-name">foo</span><span class="string">'</span>,
    <span class="comment-delimiter"># </span><span class="preprocessor">keep sorted</span><span class="comment">
</span>    srcs = <span class="builtin">glob</span>([<span class="string">'*.cc'</span>]),
    alwayslink = <span class="constant">True</span>,
    linkstatic=<span class="constant">True</span>,
)

some_rule(name = <span class="string">'foo'</span> + SUFFIX)

name_only(name = <span class="string">'</span><span class="variable-name">foo</span><span class="string">'</span>)

some_rule(
    filename = <span class="string">'file.txt'</span>,
    load=0, glob=1
)
=-=-=

Name: Font locking for .bazelrc files
Code: (lambda () (bazelrc-mode) (htmlfontify-buffer))

=-=
import %workspace%/other.bazelrc
# Comment
build --verbose_failures
=-=
<span class="keyword">import</span> %workspace%/other.bazelrc
<span class="comment-delimiter"># </span><span class="comment">Comment
</span><span class="variable-name">build</span> --verbose_failures
=-=-=

Name: Font locking for .bazelignore files
Code: (lambda () (bazelignore-mode) (htmlfontify-buffer))
No-Before-Newline: t
No-After-Newline: t

Comments in .bazelignore files must cover an entire line,
cf. https://github.com/bazelbuild/bazel/blob/09c621e4cf5b968f4c6cdf905ab142d5961f9ddc/src/main/java/com/google/devtools/build/lib/skyframe/IgnoredPackagePrefixesFunction.java#L123.

=-=
# comment

directory

directory/subdirectory
directory # with number sign
# comment at end of buffer
=-=
<span class="comment-delimiter"># </span><span class="comment">comment
</span>
directory

directory/subdirectory
directory # with number sign
<span class="comment-delimiter"># </span><span class="comment">comment at end of buffer</span>
=-=-=
